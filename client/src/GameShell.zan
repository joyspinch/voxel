using System;
using System.Collections.Generic;
using System.IO;
using System.Json;
using Game.Foundation;
using Game.Foundation.Gui;

// 立方世界 · VOXEL 的外壳：存档（最远视距 / 已放置方块数 / 出场次数）
// + 设置（难度 / 视距 / 自动旋转）+ 设置浮层。
//
// 存档基座（原子写 + 备份回退 + 版本号）与设置逻辑层（档位计算 + 校验 +
// 落盘）都在公共包 Game.Foundation 里；这里只留"这个游戏存什么、设置有哪
// 几项"——换个游戏换的正是这两行。
public class GameShell {
    GameSaveStore store;
    GameSettings settings;
    SettingsModel model;
    SettingsOverlay overlay;
    int bestDist;     // 最远视距
    int bestBlocks;   // 已放置方块数（场景方块数峰值）
    int runs;         // 出场次数

    public GameShell() {
        string dir = GameShell.SaveDir();
        Directory.CreateDirectory(dir);
        this.store = new GameSaveStore(dir, "voxel", 1);
        this.settings = new GameSettings().At(dir + "/settings.json");
        // 难度：相机转速（视角转得越快越难驾驭）。
        this.settings.AddIntChoice("difficulty", "难度", 2,
            new List<int> { 1, 2, 3 });
        // 视距：相机拉远拉近，决定能看到多远。
        this.settings.AddIntChoice("zoom", "视距", 22,
            new List<int> { 16, 22, 30 });
        // 自动旋转：关掉后视角不再自转（骨架阶段唯一的"操作"）。
        this.settings.AddBool("autoSpin", "自动旋转", true);
        this.settings.Load();
        this.model = new SettingsModel(this.settings);
        this.overlay = new SettingsOverlay(this.model);
        this.overlay.SetTitle("设置");
        this.Load();
    }

    // 存档目录：%LOCALAPPDATA%/Voxel（可用 VOXEL_SAVE 环境变量覆盖，
    // 测试脚本靠它把存档落在临时目录里，不污染玩家机器）。
    static string SaveDir() {
        string overridden = Environment.GetEnvironmentVariable("VOXEL_SAVE");
        if (overridden != "") { return overridden; }
        string basePath = Environment.GetEnvironmentVariable("LOCALAPPDATA");
        if (basePath == "") { basePath = Directory.GetCurrentDirectory(); }
        return basePath + "/Voxel";
    }

    public SettingsOverlay Overlay() { return this.overlay; }
    public int BestDist() { return this.bestDist; }
    public int BestBlocks() { return this.bestBlocks; }
    public int Runs() { return this.runs; }

    // 难度档（1/2/3）——游戏逻辑读它调相机转速。
    public int Difficulty() {
        if (this.settings == null) { return 2; }
        return this.settings.GetInt("difficulty");
    }

    // 相机转速（弧度/帧）：难度越高转得越快。
    public float SpinRate() {
        int level = this.Difficulty();
        if (level <= 1) { return 0.0018f; }
        if (level >= 3) { return 0.0060f; }
        return 0.0035f;
    }

    // 视距档（16 / 22 / 30）。
    public int Zoom() {
        if (this.settings == null) { return 22; }
        return this.settings.GetInt("zoom");
    }

    public bool AutoSpin() {
        return this.settings != null && this.settings.GetBool("autoSpin");
    }

    // 读档：没有存档就用默认值，不报错。
    public void Load() {
        JsonValue data = this.store.Load(0);
        if (data == null) {
            this.bestDist = 0;
            this.bestBlocks = 0;
            this.runs = 0;
            return;
        }
        this.bestDist = data.Int("bestDist", 0);
        this.bestBlocks = data.Int("bestBlocks", 0);
        this.runs = data.Int("runs", 0);
    }

    // 最远视距只增不减。
    public void ObserveDist(int d) {
        if (d > this.bestDist) { this.bestDist = d; }
    }

    // 已放置方块数只增不减。
    public void ObserveBlocks(int n) {
        if (n > this.bestBlocks) { this.bestBlocks = n; }
    }

    // 存档：最远视距与已放置方块数只增不减，出场次数 +1。
    public void Save() {
        JsonValue data = JsonValue.NewObject();
        data.PutInt("bestDist", this.bestDist);
        data.PutInt("bestBlocks", this.bestBlocks);
        data.PutInt("runs", this.runs + 1);
        this.runs = this.runs + 1;
        this.store.Save(0, data);
    }
}
