using System;
using System.Collections.Generic;
using System.IO;
using System.Json;
using Game.Foundation;
using Game.Foundation.Gui;

// 立方世界 · VOXEL 的外壳：存档 + 设置 + 设置浮层。
//
// 存档基座（原子写 + 备份回退 + 版本号）与设置逻辑层（档位计算 + 校验 +
// 落盘）都在公共包 Game.Foundation 里；这里只留"这个游戏存什么、设置有哪
// 几项"——换个游戏换的正是这两行。
//
// 存的四样都是**跨局可见**的成长：累计建成图纸数、累计放置方块数、
// 最快通关用时、出场次数——菜单与结算面板都直接显示它们。
public class GameShell {
    GameSaveStore store;
    GameSettings settings;
    SettingsModel model;
    SettingsOverlay overlay;
    int blueprintsDone;   // 累计建成图纸数
    int blocksPlaced;     // 累计放置方块数
    int bestTimeMs;       // 最快通关用时（毫秒，0 = 还没通关过）
    int runs;             // 出场次数

    public GameShell() {
        string dir = GameShell.SaveDir();
        Directory.CreateDirectory(dir);
        this.store = new GameSaveStore(dir, "voxel", 2);
        this.settings = new GameSettings().At(dir + "/settings.json");
        // 难度：建造时限倍率（宽松 / 标准 / 紧张）。
        this.settings.AddIntChoice("difficulty", "建造时限", 2,
            new List<int> { 1, 2, 3 });
        // 图纸提示：在场景里画出图纸要求的格子。
        this.settings.AddBool("hint", "图纸提示", true);
        this.settings.Load();
        this.model = new SettingsModel(this.settings);
        this.overlay = new SettingsOverlay(this.model);
        this.overlay.SetTitle("设置");
        this.overlay.SetCloseText("关闭");
        this.Load();
    }

    // 存档目录：%LOCALAPPDATA%/Voxel（可用 VOXEL_SAVE 环境变量覆盖，
    // 测试脚本靠它把存档落在临时目录里，不污染玩家机器）。
    static string SaveDir() {
        string overridden = Environment.GetEnvironmentVariable("VOXEL_SAVE");
        if (overridden != "") { return overridden; }
        string basePath = Environment.GetEnvironmentVariable("LOCALAPPDATA");
        if (basePath == "") { basePath = Directory.GetCurrentDirectory(); }
        return basePath + "/Voxel";
    }

    public SettingsOverlay Overlay() { return this.overlay; }
    public int BlueprintsDone() { return this.blueprintsDone; }
    public int BlocksPlaced() { return this.blocksPlaced; }
    public int BestTimeMs() { return this.bestTimeMs; }
    public int Runs() { return this.runs; }

    // 难度档（1/2/3）——时限倍率。
    public int Difficulty() {
        if (this.settings == null) { return 2; }
        return this.settings.GetInt("difficulty");
    }

    public float TimeScale() {
        int level = this.Difficulty();
        if (level <= 1) { return 1.5f; }
        if (level >= 3) { return 0.7f; }
        return 1.0f;
    }

    public bool Hint() {
        if (this.settings == null) { return true; }
        return this.settings.GetBool("hint");
    }

    // 读档：没有存档就用默认值，不报错。
    public void Load() {
        JsonValue data = this.store.Load(0);
        if (data == null) {
            this.blueprintsDone = 0;
            this.blocksPlaced = 0;
            this.bestTimeMs = 0;
            this.runs = 0;
            return;
        }
        this.blueprintsDone = data.Int("blueprintsDone", 0);
        this.blocksPlaced = data.Int("blocksPlaced", 0);
        this.bestTimeMs = data.Int("bestTimeMs", 0);
        this.runs = data.Int("runs", 0);
    }

    // 记一次建成：图纸数 +1。
    public void RecordBuild(int blueprints, int placed) {
        this.blueprintsDone = this.blueprintsDone + blueprints;
        this.blocksPlaced = this.blocksPlaced + placed;
    }

    // 一局结束时结算本局放置的方块数。
    public void RecordBlocks(int placed) {
        if (placed <= 0) { return; }
        this.blocksPlaced = this.blocksPlaced + placed;
    }

    // 通关一次：只记最快用时。
    public void RecordFinish(int elapsedMs) {
        if (elapsedMs <= 0) { return; }
        if (this.bestTimeMs == 0 || elapsedMs < this.bestTimeMs) {
            this.bestTimeMs = elapsedMs;
        }
    }

    // 存档：累计值落盘，出场次数 +1。
    public void Save() {
        this.runs = this.runs + 1;
        JsonValue data = JsonValue.NewObject();
        data.PutInt("blueprintsDone", this.blueprintsDone);
        data.PutInt("blocksPlaced", this.blocksPlaced);
        data.PutInt("bestTimeMs", this.bestTimeMs);
        data.PutInt("runs", this.runs);
        this.store.Save(0, data);
    }
}
