using System;
using System.Collections.Generic;
using Gui;
using Game.Kit;

// 画面层：等距场景、贴图加载、HUD、菜单与结算面板。
//
// 布局按 1280×800 设计分辨率写死（CDraw.StageViewport 负责等比缩放到
// 任意窗口），坐标全是逻辑像素。
//
// 本轮品质改造（docs/GAME_UI_AND_FACING.md）：
//   1. 朝向：玩家贴图换成两帧精灵表（VoxelFacing 取帧），光标带朝向箭头；
//   2. UI 图形化：HUD / 背包条 / 图纸卡 / 结算面板 / 按钮都走美术底板
//      （九宫格），颜色一律取自 VoxelPalette；
//   3. 场景体积感：地面有低频结构（裂缝 / 苔藓 / 矿脉贴花）、相邻块之间有
//      接触阴影、崖沿有受光边、角色有落地投影。
public class VoxelView {
    public const int DesignW = 1280;
    public const int DesignH = 800;

    // 背包条槽位几何（画面与点击判定共用一份，免得两处对不上）。
    public const int SlotSize = 64;
    public const int SlotGap = 8;

    // 九宫格角切片边长（**源图像素**）：与 client/assets/ui_*.png 对齐。
    public const int BoardCorner = 32;
    public const int BarCorner = 24;
    public const int SlotCorner = 16;
    public const int ButtonCorner = 14;

    public static int SlotX(int w, int kind) {
        int total = VoxelWorld.KindCount * (VoxelView.SlotSize + VoxelView.SlotGap)
            - VoxelView.SlotGap;
        int x0 = (w - total) / 2;
        return x0 + (kind - 1) * (VoxelView.SlotSize + VoxelView.SlotGap);
    }

    public static int SlotY(int h) { return h - 112; }

    public string bgPath = "";
    public string playerPath = "";        // 两帧精灵表 192x128（0=朝右 1=朝左）
    public string titlePath = "";
    public string blueprintPath = "";
    public string boardPath = "";          // 面板底板
    public string barPath = "";            // 顶栏底板
    public string slotPath = "";           // 背包槽底板
    public string buttonPath = "";         // 按钮常态
    public string buttonHoverPath = "";    // 按钮悬停
    public string buttonPressedPath = "";  // 按钮按下
    public string buttonPrimaryPath = "";  // 按钮强调
    public string shadowPath = "";         // 落地投影
    public string[] blockPaths = new string[VoxelWorld.KindCount];
    public VoxelTerrain terrain = new VoxelTerrain();
    public bool assetsReady;

    // 载入贴图（找不到就退回纯色绘制，不崩）。
    public void LoadAssets() {
        this.bgPath = VoxelView.FindAsset("assets/bg_sky.png");
        this.playerPath = VoxelView.FindAsset("assets/player_sheet.png");
        this.titlePath = VoxelView.FindAsset("assets/title.png");
        this.blueprintPath = VoxelView.FindAsset("assets/blueprint.png");
        this.boardPath = VoxelView.FindAsset("assets/ui_board.png");
        this.barPath = VoxelView.FindAsset("assets/ui_bar.png");
        this.slotPath = VoxelView.FindAsset("assets/ui_slot.png");
        this.buttonPath = VoxelView.FindAsset("assets/ui_button.png");
        this.buttonHoverPath = VoxelView.FindAsset("assets/ui_button_hover.png");
        this.buttonPressedPath = VoxelView.FindAsset("assets/ui_button_pressed.png");
        this.buttonPrimaryPath = VoxelView.FindAsset("assets/ui_button_primary.png");
        this.shadowPath = VoxelView.FindAsset("assets/shadow.png");
        this.blockPaths[VoxelWorld.Grass] = VoxelView.FindAsset("assets/block_grass.png");
        this.blockPaths[VoxelWorld.Stone] = VoxelView.FindAsset("assets/block_stone.png");
        this.blockPaths[VoxelWorld.Wood] = VoxelView.FindAsset("assets/block_wood.png");
        this.blockPaths[VoxelWorld.Ore] = VoxelView.FindAsset("assets/block_ore.png");
        this.terrain.crackPath = VoxelView.FindAsset("assets/decal_crack.png");
        this.terrain.mossPath = VoxelView.FindAsset("assets/decal_moss.png");
        this.terrain.veinPath = VoxelView.FindAsset("assets/decal_vein.png");
        this.assetsReady = this.playerPath != ""
            && this.blockPaths[VoxelWorld.Grass] != ""
            && this.blockPaths[VoxelWorld.Stone] != "";
    }

    static string FindAsset(string rel) {
        string p = Assets.Find(rel);
        if (!File.Exists(p)) { return ""; }
        return p;
    }

    public string BlockPath(int kind) {
        if (kind <= 0 || kind >= VoxelWorld.KindCount) { return ""; }
        return this.blockPaths[kind];
    }

    // ----- 面板底板（九宫格）---------------------------------------------

    // 画一块九宫格面板；底板缺失时退回纯色圆角矩形（不崩）。
    public void Plate(Canvas c, string path, int x, int y, int w, int h,
                      int corner, int fallback) {
        if (path != "") {
            VoxelPaint.NineSlice(c, path, x, y, w, h, corner);
            return;
        }
        VoxelPaint.FillRound(c, x, y, w, h, 8, fallback);
    }

    // ----- 方块 ------------------------------------------------------------

    // 方块贴图（找不到贴图时退回纯色菱形，形状还在）。
    public void DrawBlock(Canvas c, VoxelWorld world, int x, int y, int z,
                          int kind, int left, int topY) {
        string path = this.BlockPath(kind);
        if (path != "") {
            CDraw.BlitImage(c, path, left, topY, VoxelIso.BlockW, VoxelIso.BlockH);
        } else {
            int col = VoxelPalette.BlockOf(kind);
            VoxelPaint.DiamondFill(c, left + VoxelIso.BlockW / 2,
                topY + VoxelIso.TH / 2, VoxelIso.TW / 2, VoxelIso.TH / 2, col);
            VoxelPaint.Fill(c, left + 8, topY + VoxelIso.TH, VoxelIso.BlockW - 16,
                VoxelIso.LEVEL, col);
        }
        // 只有列顶那一块有顶面，贴花与接触阴影只画在顶面。
        if (y != world.ColumnTop(x, z) - 1) { return; }
        this.DrawDecal(c, world, x, y, z, kind, left, topY);
        this.DrawContact(c, world, x, z, left, topY);
    }

    // 地面贴花：低频结构（裂缝 / 苔藓 / 矿脉），叠在顶面之上。
    public void DrawDecal(Canvas c, VoxelWorld world, int x, int y, int z,
                          int kind, int left, int topY) {
        if (kind == VoxelWorld.Wood) { return; }
        int decal = VoxelTerrain.DecalAt(x, z);
        // 苔藓长在草上、矿脉长在岩上——贴花与方块材质对得上才不别扭。
        if (decal == VoxelTerrain.DecalMoss && kind != VoxelWorld.Grass) {
            decal = VoxelTerrain.DecalNone;
        }
        if (decal == VoxelTerrain.DecalVein && kind != VoxelWorld.Stone
            && kind != VoxelWorld.Ore) {
            decal = VoxelTerrain.DecalNone;
        }
        if (decal == VoxelTerrain.DecalNone) { return; }
        string path = this.terrain.PathOf(decal);
        if (path == "") { return; }
        CDraw.BlitImage(c, path, left, topY, VoxelIso.BlockW, VoxelIso.BlockH);
    }

    // 接触阴影 + 崖沿受光边：相邻块之间的暗边让"体块"读得出来。
    //
    // 顶面菱形的四条边对应四个网格方向：
    //   下右(E→S) = +x 邻居   下左(S→W) = +z 邻居
    //   上左(W→N) = -x 邻居   上右(N→E) = -z 邻居
    // 同高 → 接缝暗边；邻居更低 → 崖沿受光边；邻居更高 → 这条边被挡住，不画。
    public void DrawContact(Canvas c, VoxelWorld world, int x, int z,
                            int left, int topY) {
        int cx = left + VoxelIso.BlockW / 2;
        int cy = topY + VoxelIso.TH / 2;
        int hw = VoxelIso.TW / 2;
        int hh = VoxelIso.TH / 2;
        int myTop = world.ColumnTop(x, z);
        VoxelView.EdgeShade(c, cx, cy, hw, hh, 1,
            world.ColumnTop(x + 1, z), myTop);
        VoxelView.EdgeShade(c, cx, cy, hw, hh, 2,
            world.ColumnTop(x, z + 1), myTop);
        // 背面两条：只有同高才有接缝，弱一点（远侧）。
        if (world.ColumnTop(x - 1, z) == myTop) {
            VoxelPaint.DiamondEdge(c, cx, cy, hw, hh, 3,
                VoxelPalette.ContactSoft, 1, 0.08f);
        }
        if (world.ColumnTop(x, z - 1) == myTop) {
            VoxelPaint.DiamondEdge(c, cx, cy, hw, hh, 0,
                VoxelPalette.ContactSoft, 1, 0.08f);
        }
    }

    static void EdgeShade(Canvas c, int cx, int cy, int hw, int hh, int edge,
                           int nTop, int myTop) {
        if (nTop == myTop) {
            VoxelPaint.DiamondEdge(c, cx, cy, hw, hh, edge,
                VoxelPalette.ContactShadow, 2, 0.10f);
            return;
        }
        if (nTop < myTop) {
            VoxelPaint.DiamondEdge(c, cx, cy, hw, hh, edge,
                VoxelPalette.RimLight, 2, 0.06f);
            return;
        }
    }

    // ----- 角色 ------------------------------------------------------------

    // 玩家立绘：两帧精灵表按朝向取帧；脚下有软投影，位置才可信。
    public void DrawPlayer(Canvas c, VoxelGame game) {
        int cx = game.iso.SX(game.playerX, game.playerZ);
        int groundY = game.iso.SY(game.playerX, game.playerZ, 0);
        int w = 48;
        int h = 64;
        int left = cx - w / 2;
        // 脚踩在地面上（略微压进地面一点，免得"浮"着）。
        int topY = groundY - h + 4;
        // 脚下投影：软椭圆贴图（贴图缺失时退回半透明菱形）。
        this.DrawShadow(c, cx, groundY + 2, 54, 26);
        if (this.playerPath != "") {
            VoxelPaint.BlitSrc(c, this.playerPath, left, topY, w, h,
                VoxelFacing.SrcXOf(game.facing), 0,
                VoxelFacing.PlayerFrameW, VoxelFacing.PlayerFrameH);
        } else {
            VoxelPaint.Fill(c, left + 12, topY + 8, 24, 48, VoxelPalette.Accent);
            VoxelPaint.Fill(c, left + 14, topY, 20, 14, VoxelPalette.Info);
        }
    }

    // 落地投影（软椭圆）。
    public void DrawShadow(Canvas c, int cx, int cy, int w, int h) {
        if (this.shadowPath != "") {
            CDraw.BlitImage(c, this.shadowPath, cx - w / 2, cy - h / 2, w, h);
            return;
        }
        VoxelPaint.DiamondFill(c, cx, cy, w / 4, h / 4, VoxelPalette.Shadow);
    }
    // ----- 场景 ------------------------------------------------------------

    // 场景：背景 → 等距世界 → 图纸提示 → 放置光标
    public void DrawScene(Canvas c, VoxelGame game, int w, int h) {
        if (this.bgPath != "") {
            CDraw.BlitImage(c, this.bgPath, 0, 0, w, h);
            // 远景压暗一档：背景太亮太密会把前景的方块与 HUD 吞掉。
            VoxelPaint.Fill(c, 0, 0, w, h, 0x580E1218);
        } else {
            VoxelPaint.FillVGrad(c, 0, 0, w, h, VoxelPalette.BgStage,
                VoxelPalette.BgDeep);
        }
        this.DrawWorld(c, game, w, h);
        if (game.shell.Hint()) { this.DrawBlueprintHints(c, game); }
        this.DrawCursor(c, game);
        if (game.fx != null) { game.fx.Draw(c, game.iso); }
    }

    // 世界：按 x+z 升序（同深度再按 y 升序）画家算法画方块。
    public void DrawWorld(Canvas c, VoxelGame game, int w, int h) {
        VoxelWorld world = game.world;
        VoxelIso iso = game.iso;
        int maxD = VoxelWorld.SizeX + VoxelWorld.SizeZ - 2;
        for (int d = 0; d <= maxD; d = d + 1) {
            for (int x = 0; x < VoxelWorld.SizeX; x = x + 1) {
                int z = d - x;
                if (z < 0 || z >= VoxelWorld.SizeZ) { continue; }
                int top = world.ColumnTop(x, z);
                for (int y = 0; y < top; y = y + 1) {
                    int kind = world.Get(x, y, z);
                    if (kind == VoxelWorld.Air) { continue; }
                    int left = iso.BlockLeft(x, z);
                    int topY = iso.BlockTop(x, z, y);
                    if (left > w || left + VoxelIso.BlockW < 0) { continue; }
                    if (topY > h || topY + VoxelIso.BlockH < 0) { continue; }
                    // 完全被挡住的三面体（顶盖 + 两个前侧面都实心）不画：
                    // 埋在山体里的方块谁也看不见，省下的都是真金白银的绘制。
                    if (y + 1 < top
                        && world.Get(x, y + 1, z) != VoxelWorld.Air
                        && world.Get(x + 1, y, z) != VoxelWorld.Air
                        && world.Get(x, y, z + 1) != VoxelWorld.Air) {
                        continue;
                    }
                    this.DrawBlock(c, world, x, y, z, kind, left, topY);
                }
            }
        }
        // 角色最后画：地形有高差，深度正确的画法会把人整个埋进崖壁后面，
        // 玩家看不见自己就没法玩。等距建造类一律让角色压在场景上层。
        this.DrawPlayer(c, game);
    }

    // 图纸提示：已满足的格子填一层淡色，没满足的画黄框。
    public void DrawBlueprintHints(Canvas c, VoxelGame game) {
        VoxelPlan plan = game.plans.At(game.planIndex);
        if (plan == null) { return; }
        for (int i = 0; i < plan.reqs.Length; i = i + 1) {
            VoxelReq r = plan.reqs[i];
            int cx = game.iso.SX(r.x, r.z);
            int cy = game.iso.SY(r.x, r.z, r.y);
            if (game.world.Get(r.x, r.y, r.z) == r.kind) {
                VoxelPaint.DiamondFill(c, cx, cy, VoxelIso.TW / 2 - 4,
                    VoxelIso.TH / 2 - 2, 0x30FFFFFF);
                continue;
            }
            VoxelPaint.Diamond(c, cx, cy, VoxelIso.TW / 2 - 3, VoxelIso.TH / 2 - 2,
                VoxelPalette.AccentText, 2);
        }
    }

    // 放置光标：面朝方向的相邻格 + 当前建造高度 + 朝向箭头。
    public void DrawCursor(Canvas c, VoxelGame game) {
        int tx = game.TargetX();
        int tz = game.TargetZ();
        int ty = game.cursorY();
        if (!game.world.InBounds(tx, ty, tz)) { return; }
        int cx = game.iso.SX(tx, tz);
        int cy = game.iso.SY(tx, tz, ty);
        int ok = game.build.CanPlace(tx, ty, tz, game.selected) ? 1 : 0;
        int col = VoxelPalette.CursorOk;
        if (ok == 0) { col = VoxelPalette.CursorBad; }
        VoxelPaint.DiamondFill(c, cx, cy, VoxelIso.TW / 2 - 2, VoxelIso.TH / 2 - 1,
            VoxelPalette.CursorFill);
        VoxelPaint.Diamond(c, cx, cy, VoxelIso.TW / 2 - 2, VoxelIso.TH / 2 - 1,
            col, 3);
        // 朝向箭头：跟着面朝方向走，玩家一眼看出"下一格往哪建"。
        this.DrawFacingArrow(c, game, cx, cy, col);
        // 竖向标杆：从光标往下连到地面，玩家一眼看出当前建造高度。
        int groundY = game.iso.SY(tx, tz, 0);
        if (groundY > cy) {
            VoxelPaint.Line(c, cx, cy, cx, groundY, VoxelPalette.CursorPost, 2);
        }
    }

    // 朝向箭头（V 形，尖端指着面朝方向）。
    public void DrawFacingArrow(Canvas c, VoxelGame game, int cx, int cy, int col) {
        int dx = VoxelFacing.DirX(game.facing);
        int dy = VoxelFacing.DirY(game.facing);
        int ax = cx + dx * 8;
        int ay = cy + dy * 5;
        int back = 6;
        int splay = 5;
        // 垂直于方向的单位分量（屏幕 2:1 比例）。
        int vx = -dy * 2;
        int vy = dx;
        int x0 = ax - dx * back + vx * splay / 2;
        int y0 = ay - dy * back + vy * splay / 2;
        int x1 = ax - dx * back - vx * splay / 2;
        int y1 = ay - dy * back - vy * splay / 2;
        VoxelPaint.Line(c, ax, ay, x0, y0, col, 2);
        VoxelPaint.Line(c, ax, ay, x1, y1, col, 2);
    }

    // ----- HUD -------------------------------------------------------------

    // HUD：顶栏（图纸进度 / 计时）+ 左侧图纸卡 + 底部背包条 + 操作提示。
    public void DrawHud(Canvas c, VoxelGame game, int w, int h) {
        VoxelPlan plan = game.plans.At(game.planIndex);
        // 顶栏底板
        this.Plate(c, this.barPath, 0, 0, w, 48, VoxelView.BarCorner,
            VoxelPalette.BarBg);
        VoxelPaint.Fill(c, 0, 46, w, 2, VoxelPalette.AccentDim);
        VoxelPaint.TextShadow(c, "立方世界 · VOXEL", 16, 12, 22,
            VoxelPalette.AccentText, VoxelPalette.FgShadow);
        string planText = "图纸 " + Convert.ToString(game.planIndex + 1) + "/"
            + Convert.ToString(game.plans.Count());
        if (plan != null) {
            planText = planText + "   " + plan.name + "   "
                + Convert.ToString(game.plans.Progress(game.planIndex, game.world))
                + "/" + Convert.ToString(plan.reqs.Length);
        } else {
            planText = "图纸 " + Convert.ToString(game.plans.Count()) + "/"
                + Convert.ToString(game.plans.Count()) + "   全部建成";
        }
        VoxelPaint.TextShadow(c, planText, 250, 17, 15,
            VoxelPalette.FgSecondary, VoxelPalette.FgShadow);
        int left = game.planLimitMs();
        string timeText = VoxelPaint.FmtTime(game.elapsedMs);
        if (left > 0) { timeText = timeText + "   剩余 " + VoxelPaint.FmtTime(left); }
        VoxelPaint.TextShadow(c, timeText, w - 210, 17, 15,
            VoxelPalette.AccentText, VoxelPalette.FgShadow);

        if (plan != null) { this.DrawPlanCard(c, game, 16, 58); }

        // 背包条：底板 + 槽位 + 图标 + 数量
        int slot = VoxelView.SlotSize;
        int gap = VoxelView.SlotGap;
        int total = VoxelWorld.KindCount * (slot + gap) - gap;
        int x0 = (w - total) / 2;
        int y0 = VoxelView.SlotY(h);
        this.Plate(c, this.boardPath, x0 - 14, y0 - 12, total + 28, slot + 24,
            VoxelView.BoardCorner, VoxelPalette.PanelBgSoft);
        for (int k = 1; k < VoxelWorld.KindCount; k = k + 1) {
            int x = x0 + (k - 1) * (slot + gap);
            bool on = (k == game.selected);
            this.Plate(c, this.slotPath, x, y0, slot, slot, VoxelView.SlotCorner,
                on ? VoxelPalette.PanelBgSoft : VoxelPalette.SlotBg);
            if (on) {
                VoxelPaint.Round(c, x + 1, y0 + 1, slot - 2, slot - 2, 6,
                    VoxelPalette.Accent, 2);
            }
            string path = this.BlockPath(k);
            if (path != "") {
                CDraw.BlitImage(c, path, x + 8, y0 + 2, slot - 16, slot - 16);
            }
            VoxelPaint.TextShadow(c, Convert.ToString(game.build.Stock(k)),
                x + slot - 24, y0 + slot - 24, 16,
                VoxelPalette.FgPrimary, VoxelPalette.FgShadow);
            VoxelPaint.TextShadow(c, Convert.ToString(k), x + 6, y0 + 4, 14,
                VoxelPalette.AccentText, VoxelPalette.FgShadow);
        }
        VoxelPaint.TextShadow(c, "1 草  2 石  3 木  4 矿   ·   Q/E 升降建造高度   ·   "
            + "WASD/方向键 移动   ·   左键放置  右键破坏   ·   Esc 设置",
            16, h - 26, 14, VoxelPalette.FgSecondary, VoxelPalette.FgShadow);
    }

    // 左侧图纸卡：羊皮纸底板 + 图纸名 + 进度 + 材料清单。
    public void DrawPlanCard(Canvas c, VoxelGame game, int x, int y) {
        VoxelPlan plan = game.plans.At(game.planIndex);
        int cw = 236;
        int ch = 168;
        if (this.blueprintPath != "") {
            CDraw.BlitImage(c, this.blueprintPath, x, y, cw, ch);
        } else {
            VoxelPaint.FillRound(c, x, y, cw, ch, 6, 0xF0221A10);
        }
        VoxelPaint.Round(c, x, y, cw, ch, 6, VoxelPalette.Edge, 2);
        if (plan == null) { return; }
        VoxelPaint.Text(c, "图纸 " + Convert.ToString(game.planIndex + 1)
            + " · " + plan.name, x + 12, y + 12, 17, 0xFF3A2A12);
        VoxelPaint.Text(c, plan.brief, x + 12, y + 36, 13, 0xFF5A4426);
        int done = game.plans.Progress(game.planIndex, game.world);
        VoxelPaint.Text(c, "进度 " + Convert.ToString(done) + " / "
            + Convert.ToString(plan.reqs.Length), x + 12, y + 56, 15, 0xFF2E4A6B);
        VoxelPaint.Fill(c, x + 12, y + 78, cw - 24, 6, 0x55FFFFFF);
        int w = cw - 24;
        int fw = done * w / plan.reqs.Length;
        if (fw < 1 && done > 0) { fw = 1; }
        VoxelPaint.Fill(c, x + 12, y + 78, fw, 6, VoxelPalette.Copper);
        string[] names = new string[] { "草", "石", "木", "矿" };
        int ty = y + 96;
        for (int k = 1; k < VoxelWorld.KindCount; k = k + 1) {
            int need = game.plans.NeedOf(game.planIndex, k);
            if (need <= 0) { continue; }
            VoxelPaint.Text(c, names[k - 1] + " ×" + Convert.ToString(need),
                x + 12, ty, 14, 0xFF4A3418);
            ty = ty + 19;
        }
    }

    // ----- 菜单 ------------------------------------------------------------

    // 菜单画面
    public void DrawMenu(Canvas c, VoxelGame game, int w, int h) {
        if (this.bgPath != "") {
            CDraw.BlitImage(c, this.bgPath, 0, 0, w, h);
        } else {
            VoxelPaint.FillVGrad(c, 0, 0, w, h, VoxelPalette.BgStage,
                VoxelPalette.BgDeep);
        }
        VoxelPaint.Fill(c, 0, h - 190, w, 190, 0x90081008);
        int pw = 620;
        if (this.titlePath != "") {
            CDraw.BlitImage(c, this.titlePath, (w - pw) / 2, 70, pw, pw / 4);
        }
        VoxelPaint.TextShadowCentered(c, "立  方  世  界", w / 2, 130, w, 56,
            VoxelPalette.AccentText, VoxelPalette.FgShadow);
        VoxelPaint.TextShadowCentered(c, "VOXEL · 等距体素建造", w / 2, 196, w, 18,
            VoxelPalette.FgPrimary, VoxelPalette.FgShadow);
        VoxelPaint.TextShadowCentered(c, "按图纸把石台、灯柱、瞭望塔一层层建起来",
            w / 2, 226, w, 16, VoxelPalette.FgSecondary, VoxelPalette.FgShadow);
        string best = "尚无记录";
        if (game.shell.BestTimeMs() > 0) {
            best = VoxelPaint.FmtTimeFine(game.shell.BestTimeMs());
        }
        VoxelPaint.TextShadowCentered(c,
            "累计建成图纸 " + Convert.ToString(game.shell.BlueprintsDone())
            + "   累计放置方块 " + Convert.ToString(game.shell.BlocksPlaced())
            + "   最快通关 " + best
            + "   出场 " + Convert.ToString(game.shell.Runs()) + " 次",
            w / 2, h - 150, w, 18, VoxelPalette.FgPrimary, VoxelPalette.FgShadow);
        VoxelPaint.TextShadowCentered(c, "点击「开始建造」· Esc 打开设置",
            w / 2, h - 110, w, 15, VoxelPalette.FgTertiary, VoxelPalette.FgShadow);
    }

    // 结算面板
    public void DrawResult(Canvas c, VoxelGame game, int w, int h) {
        VoxelPaint.Fill(c, 0, 0, w, h, 0xB0000000);
        int pw = 560;
        int ph = 350;
        int px = (w - pw) / 2;
        int py = (h - ph) / 2 - 20;
        this.Plate(c, this.boardPath, px, py, pw, ph, VoxelView.BoardCorner,
            VoxelPalette.PanelBg);
        VoxelPaint.Round(c, px + 3, py + 3, pw - 6, ph - 6, 10,
            VoxelPalette.Edge, 2);
        VoxelPaint.Fill(c, px + 18, py + 14, pw - 36, 1, VoxelPalette.EdgeDark);
        string title = "建造完成";
        int titleCol = VoxelPalette.AccentText;
        if (game.failed) {
            title = "建造失败";
            titleCol = VoxelPalette.Danger;
        }
        VoxelPaint.TextShadowCentered(c, title, px + pw / 2, py + 28, pw, 34,
            titleCol, VoxelPalette.FgShadow);
        string reason = game.failReason;
        if (reason == "") { reason = "三张图纸全部建成，工地交付"; }
        VoxelPaint.TextShadowCentered(c, reason, px + pw / 2, py + 72, pw, 16,
            VoxelPalette.FgSecondary, VoxelPalette.FgShadow);
        int ty = py + 112;
        string[] labels = new string[] {
            "建成图纸", "本局用时", "最快通关", "本局放置", "累计放置"
        };
        string[] values = new string[] {
            Convert.ToString(game.planIndex) + " / " + Convert.ToString(game.plans.Count()),
            VoxelPaint.FmtTimeFine(game.elapsedMs),
            game.shell.BestTimeMs() > 0 ? VoxelPaint.FmtTimeFine(game.shell.BestTimeMs()) : "—",
            Convert.ToString(game.runPlaced),
            Convert.ToString(game.shell.BlocksPlaced() + game.runPlaced)
        };
        for (int i = 0; i < labels.Length; i = i + 1) {
            VoxelPaint.Text(c, labels[i], px + 44, ty, 17, VoxelPalette.FgSecondary);
            VoxelPaint.Text(c, values[i], px + 250, ty, 17, VoxelPalette.FgPrimary);
            ty = ty + 32;
        }
    }

    // ----- 按钮 ------------------------------------------------------------

    // 按钮：美术底板三态（常态 / 悬停 / 按下）+ 强调态，文字带投影。
    public void DrawButton(Canvas c, string label, int x, int y, int w, int h,
                           bool enabled, bool hover, bool pressed, int kind) {
        string path = this.buttonPath;
        int text = VoxelPalette.FgPrimary;
        if (kind == 1) {
            path = this.buttonPrimaryPath;
            text = VoxelPalette.FgInverse;
        }
        if (pressed && kind != 1) { path = this.buttonPressedPath; }
        if (hover && kind != 1) { path = this.buttonHoverPath; }
        if (!enabled) {
            path = this.buttonPath;
            text = VoxelPalette.FgTertiary;
        }
        if (path != "") {
            VoxelPaint.NineSlice(c, path, x, y, w, h, VoxelView.ButtonCorner);
        } else {
            int bg = VoxelPalette.PanelBgSoft;
            if (kind == 1) { bg = VoxelPalette.Accent; }
            if (!enabled) { bg = VoxelPalette.SlotBg; }
            VoxelPaint.FillRound(c, x, y, w, h, 6, bg);
            VoxelPaint.Round(c, x, y, w, h, 6, VoxelPalette.Edge, 2);
        }
        if (kind == 1 && !enabled) { text = VoxelPalette.FgTertiary; }
        VoxelPaint.TextShadowCentered(c, label, x + w / 2, y + (h - 20) / 2, w, 19,
            text, VoxelPalette.FgShadow);
    }
}
