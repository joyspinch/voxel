using System;
using Gui;
using Game.Foundation.Gui;

// 立方世界 · VOXEL 入口：建宿主 → 跑主循环。
//
// 画面是自绘游戏（Canvas 直绘等距场景），设置浮层用标准库控件挂在宿主
// HUD 层上——两者各司其职：场景要贴图与排序，设置要标准控件。
public class VoxelApp {
    static void Main() {
        VoxelGame app = new VoxelGame();
        GuiHost host = new GuiHost("立方世界 · VOXEL", 1280, 800, 16);
        host.Run(app);
    }
}
